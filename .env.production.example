# .env.production.example - Production Environment Template
# Copy this file to .env.production and fill in REAL production values
# NEVER commit .env.production file with real credentials!

# Backend Configuration
PORT=5000
NODE_ENV=production

# Database - MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/vendora?retryWrites=true&w=majority

# JWT - MUST be changed! Generate: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_here_at_least_32_chars

# Razorpay (Live Keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (Use production email service)
# Recommended: SendGrid, AWS SES, or your email provider
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key_or_email_provider_key
EMAIL_FROM=noreply@yourdomain.com

# Request Timeout
REQUEST_TIMEOUT_MS=15000

# Frontend URL - Your production domain
FRONTEND_URL=https://yourdomain.com

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com

# Optional: Add additional production configs
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
# NEW_RELIC_LICENSE_KEY=your_new_relic_key
