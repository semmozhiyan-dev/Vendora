# .env.example - Development Environment Template
# Copy this file to .env.development and fill in actual values

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database - Local MongoDB (Docker container)
MONGO_URI=mongodb://admin:admin123@mongodb:27017/vendora?authSource=admin

# JWT - Generate with: openssl rand -hex 32
JWT_SECRET=your_dev_jwt_secret_here_32_characters_minimum

# Session secret for Passport / OAuth sessions
SESSION_SECRET=generate_a_random_string_here

# Google OAuth
GOOGLE_CLIENT_ID=your_new_client_id
GOOGLE_CLIENT_SECRET=your_new_client_secret
GOOGLE_CALLBACK_URL=https://vendore.tech/api/v1/auth/google/callback

# Razorpay (Test Keys - get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=your_email@gmail.com

# Request Timeout
REQUEST_TIMEOUT_MS=10000

# Frontend URL
FRONTEND_URL=http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:5000
