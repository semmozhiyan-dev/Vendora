# .env.development.example - Development Environment Template

# Backend Configuration
PORT=5000
NODE_ENV=development

# Database - Local MongoDB (Docker container)
MONGO_URI=mongodb://<db_user>:<db_password>@mongodb:27017/vendora?authSource=admin

# JWT
JWT_SECRET=<generate-strong-random-secret>

# Razorpay (Test Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<replace-with-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<replace-with-webhook-secret>

# Email Configuration (Gmail or SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=<email-app-password-or-api-key>
EMAIL_FROM=you@example.com

# Request Timeout
REQUEST_TIMEOUT_MS=10000

# Frontend URL
FRONTEND_URL=http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:5000
