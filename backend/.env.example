# Backend Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env with real secrets!

PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://admin:admin123@mongodb:27017/vendora?authSource=admin

# JWT - Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Session secret for Passport / OAuth sessions
SESSION_SECRET=generate_a_random_string_here

# Google OAuth
GOOGLE_CLIENT_ID=your_new_client_id
GOOGLE_CLIENT_SECRET=your_new_client_secret
GOOGLE_CALLBACK_URL=https://vendore.tech/api/v1/auth/google/callback

# Razorpay - Get from dashboard
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# Request Timeout
REQUEST_TIMEOUT_MS=10000

# Frontend URL
FRONTEND_URL=http://localhost:8000
API_URL=http://localhost:8000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Configuration
# For Gmail: Enable 2FA and use App Password
# For other SMTP: Configure host, port, user, pass
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Production SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
