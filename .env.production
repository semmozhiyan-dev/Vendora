# .env.production - Production Environment Variables

# Backend Configuration
PORT=5000
NODE_ENV=production

# Database - Production MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/vendora?retryWrites=true&w=majority

# JWT - Use a strong, random secret in production
JWT_SECRET=your_secure_jwt_secret_key_here_generate_a_strong_one

# Razorpay (Live Keys - obtain from Razorpay dashboard)
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay

# Email Configuration (Use your production email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=noreply@yourdomain.com

# Request Timeout
REQUEST_TIMEOUT_MS=15000

# Frontend URL - Your production domain
FRONTEND_URL=https://yourdomain.com

# Frontend Configuration
VITE_API_URL=https://api.yourdomain.com
